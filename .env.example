# Generate strong secrets; never commit your real .env.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
CSRF_TRUSTED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

POSTGRES_DB=vibecheck
POSTGRES_USER=vibecheck
POSTGRES_PASSWORD=replace-with-a-strong-database-password
REDIS_PASSWORD=replace-with-a-strong-redis-password

WEB_BIND=127.0.0.1
WEB_PORT=3000
AUTH_COOKIE_SECURE=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
DATABASE_SSL_REQUIRE=false
TIME_ZONE=Europe/Berlin
LOG_LEVEL=INFO
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# For local HTTP development keep false. Set true behind a TLS-terminating reverse proxy.
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=31536000

# AI provider is configured by an administrator in the application UI.
# The AI API key is encrypted in the database using a key derived from DJANGO_SECRET_KEY.
